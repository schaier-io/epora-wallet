BLOCKFROST_API_KEY=replace-with-your-own-key
# Optional. Point the offchain scripts at a local devnet instead of preprod
# (pnpm devnet:up prints the URL). When unset or blank, the scripts use
# BLOCKFROST_API_KEY against preprod. When set, this must be a literal
# http(s):// URL such as http://localhost:8080/api/v1/; anything else fails fast.
CARDANO_PROVIDER_URL=
# Required by pnpm mint. Deploy the current STT reference script through /user.
STT_SPEND_REFERENCE="replace-with-reference-transaction-hash#0"
# Required by fund-wallet-example.mjs. Copy both values from pnpm mint output.
STT_POLICY_ID=replace-with-56-hex-character-policy-id
STT_ASSET_NAME=replace-with-64-hex-character-asset-name
