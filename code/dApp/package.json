{
  "name": "permission-wallet-dapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "DATABASE_URL='postgresql://postgres@localhost:5432/wallet?schema=stt_test' prisma db push && DATABASE_URL='postgresql://postgres@localhost:5432/wallet?schema=stt_test' node --import tsx --test --test-concurrency=1 'src/**/*.test.ts'",
    "test:unit": "node --import tsx --test --test-concurrency=1 'src/lib/contracts/*.test.ts' 'src/lib/user-flow/*.test.ts' 'src/components/payee/*.test.ts' 'src/components/user/*.test.ts' 'src/components/user/workspace/*.test.ts' 'src/components/user/workspace/atoms/*.test.ts' 'src/components/user/workspace/helpers/*.test.ts' 'src/lib/mesh/transactions/*.test.ts' 'src/lib/mesh/transactions/internals/*.test.ts'",
    "test:components": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "sync:blueprint": "node ./scripts/sync-blueprint.mjs",
    "sync:blueprint:check": "node ./scripts/sync-blueprint.mjs --check",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ],
    "overrides": {
      "@csstools/css-color-parser": "4.1.3",
      "@connectrpc/connect-node>undici": "^6.27.0",
      "@hono/node-server": "^2.0.5",
      "hono": "^4.12.27",
      "ip-address": "^10.1.1",
      "valibot": "^1.4.2",
      "sharp": "^0.35.0",
      "postcss": "^8.5.26",
      "fast-uri": "^3.1.4",
      "deepmerge-ts": "^8.0.1"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@harmoniclabs/crypto": "0.3.1",
    "@meshsdk/common": "1.9.1",
    "@meshsdk/core": "1.9.1",
    "@meshsdk/core-cst": "1.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "7.9.1",
    "@walletconnect/sign-client": "^2.23.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ethereum-cryptography": "^3.2.0",
    "jotai": "^2.20.2",
    "lucide-react": "1.31.0",
    "motion": "^13.1.0",
    "next": "^16.3.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.2.0",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@walletconnect/types": "^2.23.10",
    "eslint": "9.39.3",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  }
}
