{
  "name": "permission-wallet-dapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:deploy": "if [ \"$VERCEL_ENV\" = \"production\" ]; then prisma migrate deploy || exit $?; fi; pnpm build",
    "postinstall": "prisma generate && node ./scripts/sync-swagger-ui.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "env -u DATABASE_URL_UNPOOLED DATABASE_URL='postgresql://postgres@localhost:5432/wallet?schema=stt_test' prisma db push && DATABASE_URL='postgresql://postgres@localhost:5432/wallet?schema=stt_test' node --import tsx --test --test-concurrency=1 'src/**/*.test.ts'",
    "test:unit": "env -u DATABASE_URL node --import tsx --test --test-concurrency=1 'src/**/*.test.ts'",
    "test:user-flow-helpers": "node --import tsx scripts/test-user-flow-helpers.ts",
    "test:components": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "entrypoint-budget:check-generated": "node ../smart-contract/scripts/check-entrypoint-budget.mjs --check-generated",
    "bundle-budget:check": "node --test scripts/lib/bundle-budget.test.mjs && node scripts/check-bundle-budget.mjs",
    "file-length:check": "node --test scripts/lib/file-length.test.mjs && node scripts/check-file-length.mjs",
    "i18n:check": "node --test scripts/lib/i18n-static-coverage.test.mjs && node scripts/check-message-catalog.mjs && node scripts/check-intl-wiring.mjs && node scripts/generate-default-message-catalog.mjs --check && node scripts/migrate-jsx-copy-to-i18n.mjs --check && node scripts/migrate-static-copy-to-i18n.mjs --check && node scripts/check-i18n-static-coverage.mjs && node scripts/audit-i18n-internal-values.mjs",
    "i18n:extract": "node scripts/extract-ui-copy.mjs",
    "i18n:prune": "node scripts/prune-internal-messages.mjs",
    "sync:blueprint": "node ./scripts/sync-blueprint.mjs",
    "sync:blueprint:check": "node ./scripts/sync-blueprint.mjs --check",
    "openapi": "node --import tsx ./scripts/build-openapi.ts",
    "openapi:check": "node --import tsx ./scripts/build-openapi.ts --check",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ],
    "overrides": {
      "@csstools/css-color-parser": "4.1.3",
      "@connectrpc/connect-node>undici": "^6.29.1",
      "@hono/node-server": "^2.0.5",
      "hono": "^4.12.27",
      "ip-address": "^10.7.4",
      "mysql2": "3.24.3",
      "valibot": "^1.4.2",
      "sharp": "^0.35.5",
      "postcss": "^8.5.32",
      "vite@7.3.6>esbuild": "0.28.2",
      "fast-uri": "^3.1.9",
      "deepmerge-ts": "^8.0.1",
      "source-map-js": "^1.2.2",
      "undici@^6": "^6.29.1",
      "undici@^7": "^7.30.1",
      "undici@^8": "^8.12.2",
      "follow-redirects": "^1.16.2",
      "zod@>=4.0.0 <4.6.6": "4.6.7",
      "brace-expansion@^1": "1.1.21",
      "systeminformation@^5": "5.33.19",
      "pbkdf2@^3": "3.1.7"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@harmoniclabs/crypto": "0.3.1",
    "@meshsdk/common": "1.9.1",
    "@meshsdk/core": "1.9.1",
    "@meshsdk/core-cst": "1.9.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "@sentry/nextjs": "^11.10.0",
    "@tanstack/query-core": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@vercel/functions": "3.10.5",
    "@walletconnect/sign-client": "^2.26.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ethereum-cryptography": "^3.2.0",
    "jotai": "^3.0.1",
    "jotai-tanstack-query": "^0.11.0",
    "lucide-react": "1.66.0",
    "motion": "^14.9.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "swagger-ui-dist": "5.34.1",
    "tailwind-merge": "3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@walletconnect/types": "^2.26.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prisma": "^7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
