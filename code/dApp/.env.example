# Copy to .env.local and fill in. See README.md "Environment" for details.

# --- Required ---

# Blockfrost project id for the Cardano Preprod network (server-side only).
BLOCKFROST_PREPROD_PROJECT_ID=preprod...

# Prisma/Postgres connection string. The `wallet` database must exist locally
# (e.g. `createdb wallet`). Tests use an isolated `stt_test` schema.
DATABASE_URL=postgresql://postgres@localhost:5432/wallet

# Shared secret for the protected background STT sync route.
STT_SYNC_SECRET=change-me

# HMAC secret for multi-sig proposal sign-in nonces and session cookies.
# Required in production; a fixed dev fallback is used when unset locally.
PROPOSAL_AUTH_SECRET=change-me

# --- Optional ---

# Reown/WalletConnect project id for CIP-45 mobile pairing. Pairing is disabled
# when unset.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-side override for the Koios endpoint used by the credential-UTxO
# discovery proxy (/api/koios/credential-utxos). Defaults to the public
# per-network instance when unset.
KOIOS_URL=

# Absolute base URL of the deployed site, used to build public/canonical URLs.
# On Vercel, VERCEL_URL is injected automatically and used as a fallback.
NEXT_PUBLIC_SITE_URL=

# Set to "false" ONLY on a directly-exposed deployment (no Vercel/ingress/CDN
# in front): disables x-forwarded-for / x-real-ip as rate-limit identity, so
# spoofed headers can't rotate keys; all unauthenticated callers then share one
# budget. Leave unset behind a trusted proxy that owns those headers.
RATE_LIMIT_TRUST_PROXY_HEADERS=
# Number of trusted proxies that append to X-Forwarded-For (e.g. 1 for a single
# ingress nginx, 2 for Cloudflare -> ingress). When set, the client IP is taken
# that many hops in from the RIGHT and X-Forwarded-For wins over X-Real-IP — set
# this on any non-Vercel proxy chain so a spoofed X-Real-IP is ignored and a
# multi-proxy chain doesn't collapse every caller into one shared bucket. Leave
# unset on Vercel (X-Real-IP is platform-set and preferred).
RATE_LIMIT_TRUSTED_PROXY_HOPS=
